{
  "name": "prodintel-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ProdIntel StageOps – Offline Backend Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:setup": "sqlcmd -S localhost -d prodintel -i schema.sql",
    "db:create": "sqlcmd -S localhost -Q 'CREATE DATABASE prodintel'"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^12.7.4",
    "uuid": "^14.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
