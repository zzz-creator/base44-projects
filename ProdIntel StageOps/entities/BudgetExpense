{
  "name": "BudgetExpense",
  "type": "object",
  "properties": {
    "budget_id": {
      "type": "string",
      "description": "Reference to Budget"
    },
    "production_id": {
      "type": "string",
      "description": "Reference to Production"
    },
    "description": {
      "type": "string",
      "description": "Expense description"
    },
    "amount": {
      "type": "number",
      "description": "Expense amount"
    },
    "expense_date": {
      "type": "string",
      "format": "date",
      "description": "Date of expense"
    },
    "vendor": {
      "type": "string",
      "description": "Vendor/supplier name"
    },
    "receipt_url": {
      "type": "string",
      "description": "URL to receipt/invoice"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "paid",
        "rejected"
      ],
      "default": "pending",
      "description": "Expense status"
    }
  },
  "required": [
    "budget_id",
    "production_id",
    "description",
    "amount"
  ],
  "rls": {
    "create": {
      "data.created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}