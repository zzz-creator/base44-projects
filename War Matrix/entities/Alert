{
  "name": "Alert",
  "type": "object",
  "properties": {
    "alert_name": {
      "type": "string",
      "description": "Name of the alert"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Regions to monitor"
    },
    "conflict_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Types of conflicts to monitor"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords to monitor"
    },
    "probability_threshold": {
      "type": "number",
      "description": "Minimum conflict probability to trigger alert"
    },
    "severity_threshold": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Minimum severity level to trigger alert"
    },
    "notification_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "in_app",
          "email"
        ]
      },
      "description": "How to send notifications"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the alert is active"
    },
    "last_triggered": {
      "type": "string",
      "format": "date-time",
      "description": "When the alert was last triggered"
    },
    "trigger_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times triggered"
    }
  },
  "required": [
    "alert_name",
    "regions",
    "notification_methods"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}