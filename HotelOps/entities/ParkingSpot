{
  "name": "ParkingSpot",
  "type": "object",
  "properties": {
    "spot_number": {
      "type": "string",
      "description": "Parking spot identifier"
    },
    "level": {
      "type": "string",
      "description": "Parking level (P1, P2, etc.)"
    },
    "zone": {
      "type": "string",
      "enum": [
        "standard",
        "vip",
        "electric",
        "handicap",
        "compact",
        "oversized"
      ],
      "default": "standard",
      "description": "Parking zone type"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "occupied",
        "reserved",
        "maintenance"
      ],
      "default": "available",
      "description": "Current parking spot status"
    },
    "vehicle_id": {
      "type": "string",
      "description": "Foreign key to Vehicle entity (current occupant)"
    },
    "reserved_for_room": {
      "type": "string",
      "description": "Room number this spot is reserved for"
    },
    "rate_per_hour": {
      "type": "number",
      "description": "Hourly parking rate"
    },
    "has_charging": {
      "type": "boolean",
      "default": false,
      "description": "Electric vehicle charging availability"
    }
  },
  "required": [
    "spot_number",
    "level"
  ]
}