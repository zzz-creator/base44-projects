{
  "name": "RoomServiceOrder",
  "type": "object",
  "properties": {
    "guest_id": {
      "type": "string",
      "description": "Foreign key to Guest entity"
    },
    "reservation_id": {
      "type": "string",
      "description": "Foreign key to Reservation entity"
    },
    "room_id": {
      "type": "string",
      "description": "Foreign key to Room entity"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "price": {
            "type": "number"
          }
        }
      },
      "description": "Ordered items"
    },
    "total_amount": {
      "type": "number",
      "description": "Total order amount"
    },
    "special_instructions": {
      "type": "string",
      "description": "Special delivery instructions"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "preparing",
        "on_the_way",
        "delivered",
        "cancelled"
      ],
      "default": "pending",
      "description": "Order status"
    },
    "order_time": {
      "type": "string",
      "format": "date-time",
      "description": "Order timestamp"
    },
    "estimated_delivery": {
      "type": "string",
      "format": "date-time",
      "description": "Estimated delivery time"
    },
    "delivered_time": {
      "type": "string",
      "format": "date-time",
      "description": "Actual delivery time"
    }
  },
  "required": [
    "guest_id",
    "room_id",
    "items",
    "total_amount"
  ]
}