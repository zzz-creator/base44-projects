{
  "name": "LoyaltyPoints",
  "type": "object",
  "properties": {
    "guest_id": {
      "type": "string",
      "description": "Foreign key to Guest entity"
    },
    "total_points": {
      "type": "integer",
      "default": 0,
      "description": "Total available points"
    },
    "lifetime_points": {
      "type": "integer",
      "default": 0,
      "description": "Total points earned all-time"
    },
    "points_redeemed": {
      "type": "integer",
      "default": 0,
      "description": "Total points redeemed"
    },
    "current_tier": {
      "type": "string",
      "enum": [
        "standard",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "standard",
      "description": "Current loyalty tier"
    },
    "total_bookings": {
      "type": "integer",
      "default": 0,
      "description": "Total number of bookings"
    },
    "total_spent": {
      "type": "number",
      "default": 0,
      "description": "Total amount spent"
    }
  },
  "required": [
    "guest_id"
  ]
}