{
  "name": "LoyaltyReward",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Reward name"
    },
    "description": {
      "type": "string",
      "description": "Reward description"
    },
    "points_required": {
      "type": "integer",
      "description": "Points needed to redeem"
    },
    "tier_requirement": {
      "type": "string",
      "enum": [
        "standard",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "standard",
      "description": "Minimum tier required"
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "discount",
        "upgrade",
        "free_service",
        "amenity"
      ],
      "description": "Type of reward"
    },
    "value": {
      "type": "number",
      "description": "Monetary value or discount percentage"
    },
    "available": {
      "type": "boolean",
      "default": true,
      "description": "Reward availability"
    }
  },
  "required": [
    "name",
    "points_required",
    "reward_type"
  ]
}