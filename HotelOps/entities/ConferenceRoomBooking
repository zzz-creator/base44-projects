{
  "name": "ConferenceRoomBooking",
  "type": "object",
  "properties": {
    "guest_id": {
      "type": "string",
      "description": "Foreign key to Guest entity"
    },
    "conference_room_id": {
      "type": "string",
      "description": "Foreign key to ConferenceRoom entity"
    },
    "booking_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the booking"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM format)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM format)"
    },
    "duration_hours": {
      "type": "number",
      "description": "Duration in hours"
    },
    "total_cost": {
      "type": "number",
      "description": "Total cost for the booking"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed"
      ],
      "default": "pending",
      "description": "Booking status"
    },
    "purpose": {
      "type": "string",
      "description": "Purpose of the booking"
    },
    "attendees": {
      "type": "integer",
      "description": "Expected number of attendees"
    },
    "special_requests": {
      "type": "string",
      "description": "Any special requests or requirements"
    }
  },
  "required": [
    "guest_id",
    "conference_room_id",
    "booking_date",
    "start_time",
    "end_time",
    "duration_hours",
    "total_cost"
  ]
}