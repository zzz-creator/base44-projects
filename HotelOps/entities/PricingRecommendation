{
  "name": "PricingRecommendation",
  "type": "object",
  "properties": {
    "resource_type": {
      "type": "string",
      "enum": [
        "room",
        "parking",
        "service"
      ],
      "description": "Type of resource being priced"
    },
    "resource_id": {
      "type": "string",
      "description": "Foreign key to the specific resource"
    },
    "current_price": {
      "type": "number",
      "description": "Current price per unit"
    },
    "recommended_price": {
      "type": "number",
      "description": "AI recommended price per unit"
    },
    "price_change_percentage": {
      "type": "number",
      "description": "Percentage change from current price"
    },
    "demand_forecast": {
      "type": "string",
      "enum": [
        "very_low",
        "low",
        "medium",
        "high",
        "very_high"
      ],
      "description": "Forecasted demand level"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "AI confidence percentage (0-100)"
    },
    "effective_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this pricing should take effect"
    },
    "reasoning": {
      "type": "string",
      "description": "AI explanation for the price recommendation"
    },
    "market_factors": {
      "type": "object",
      "description": "Market conditions influencing the recommendation"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "expired"
      ],
      "default": "pending",
      "description": "Status of the pricing recommendation"
    }
  },
  "required": [
    "resource_type",
    "resource_id",
    "current_price",
    "recommended_price",
    "demand_forecast"
  ]
}