{
  "name": "GuestMessage",
  "type": "object",
  "properties": {
    "guest_id": {
      "type": "string",
      "description": "Foreign key to Guest entity"
    },
    "reservation_id": {
      "type": "string",
      "description": "Foreign key to Reservation entity"
    },
    "room_id": {
      "type": "string",
      "description": "Foreign key to Room entity"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "announcement",
        "promotion",
        "reminder",
        "service_update",
        "urgent"
      ],
      "description": "Type of message"
    },
    "subject": {
      "type": "string",
      "description": "Message subject"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "status": {
      "type": "string",
      "enum": [
        "unread",
        "read",
        "archived"
      ],
      "default": "unread",
      "description": "Message status"
    },
    "sent_by": {
      "type": "string",
      "description": "Staff member who sent the message"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date message was sent"
    },
    "read_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date message was read"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "default": "normal",
      "description": "Message priority"
    }
  },
  "required": [
    "message_type",
    "subject",
    "message"
  ]
}