{
  "name": "Notification",
  "type": "object",
  "properties": {
    "guest_id": {
      "type": "string",
      "description": "Foreign key to Guest entity"
    },
    "campaign_id": {
      "type": "string",
      "description": "Foreign key to Campaign entity"
    },
    "notification_type": {
      "type": "string",
      "enum": [
        "email",
        "push_notification",
        "sms",
        "in_app"
      ],
      "description": "Type of notification"
    },
    "subject": {
      "type": "string",
      "description": "Notification subject/title"
    },
    "message": {
      "type": "string",
      "description": "Notification message content"
    },
    "personalized_content": {
      "type": "object",
      "description": "AI-generated personalized content"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "opened",
        "clicked",
        "failed"
      ],
      "default": "pending",
      "description": "Notification status"
    },
    "sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date notification was sent"
    },
    "opened_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date notification was opened"
    },
    "clicked_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date notification was clicked"
    },
    "converted": {
      "type": "boolean",
      "default": false,
      "description": "Whether notification led to conversion"
    }
  },
  "required": [
    "guest_id",
    "notification_type",
    "subject",
    "message"
  ]
}