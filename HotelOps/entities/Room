{
  "name": "Room",
  "type": "object",
  "properties": {
    "room_number": {
      "type": "string",
      "description": "Room number identifier"
    },
    "floor_id": {
      "type": "string",
      "description": "Foreign key to Floor entity"
    },
    "room_type": {
      "type": "string",
      "enum": [
        "standard",
        "deluxe",
        "suite",
        "penthouse"
      ],
      "default": "standard",
      "description": "Room category"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "occupied",
        "reserved",
        "maintenance",
        "cleaning"
      ],
      "default": "available",
      "description": "Current room status"
    },
    "rate_per_night": {
      "type": "number",
      "description": "Nightly rate in currency units"
    },
    "max_occupancy": {
      "type": "integer",
      "default": 2,
      "description": "Maximum number of guests"
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of room amenities"
    }
  },
  "required": [
    "room_number",
    "floor_id",
    "rate_per_night"
  ]
}