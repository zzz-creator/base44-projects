{
  "name": "LoyaltyTransaction",
  "type": "object",
  "properties": {
    "guest_id": {
      "type": "string",
      "description": "Foreign key to Guest entity"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "earned",
        "redeemed",
        "expired"
      ],
      "description": "Transaction type"
    },
    "points": {
      "type": "integer",
      "description": "Number of points"
    },
    "description": {
      "type": "string",
      "description": "Transaction description"
    },
    "related_reservation_id": {
      "type": "string",
      "description": "Related reservation if applicable"
    },
    "related_reward_id": {
      "type": "string",
      "description": "Related reward if redeemed"
    },
    "transaction_date": {
      "type": "string",
      "format": "date-time",
      "description": "Transaction timestamp"
    }
  },
  "required": [
    "guest_id",
    "transaction_type",
    "points"
  ]
}