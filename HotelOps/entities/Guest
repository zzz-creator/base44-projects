{
  "name": "Guest",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Guest first name"
    },
    "last_name": {
      "type": "string",
      "description": "Guest last name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Guest email address"
    },
    "phone": {
      "type": "string",
      "description": "Guest phone number"
    },
    "vip_status": {
      "type": "boolean",
      "default": false,
      "description": "VIP guest flag for priority services"
    },
    "loyalty_tier": {
      "type": "string",
      "enum": [
        "standard",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "standard",
      "description": "Guest loyalty tier"
    },
    "status": {
      "type": "string",
      "enum": [
        "checked_in",
        "checked_out",
        "reserved",
        "cancelled"
      ],
      "default": "reserved",
      "description": "Current guest status"
    },
    "marketing_opt_in": {
      "type": "boolean",
      "default": true,
      "description": "Marketing communications preference"
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "push_notification"
      ],
      "default": "email",
      "description": "Preferred method for marketing contact"
    },
    "last_campaign_date": {
      "type": "string",
      "format": "date-time",
      "description": "Last date guest received marketing campaign"
    },
    "total_campaigns_received": {
      "type": "integer",
      "default": 0,
      "description": "Total marketing campaigns received"
    },
    "campaign_engagement_score": {
      "type": "number",
      "default": 0,
      "description": "AI-calculated engagement score (0-100)"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email"
  ]
}