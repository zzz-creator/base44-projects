{
  "name": "ConferenceRoom",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the conference room"
    },
    "capacity": {
      "type": "integer",
      "description": "Maximum capacity of the conference room"
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of amenities (projector, whiteboard, video conferencing, etc.)"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "booked",
        "maintenance"
      ],
      "default": "available",
      "description": "Current status of the conference room"
    },
    "rate_per_hour": {
      "type": "number",
      "description": "Hourly rate for booking the conference room"
    }
  },
  "required": [
    "name",
    "capacity",
    "rate_per_hour"
  ]
}