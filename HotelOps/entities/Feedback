{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "guest_id": {
      "type": "string",
      "description": "Foreign key to Guest entity"
    },
    "reservation_id": {
      "type": "string",
      "description": "Foreign key to Reservation entity"
    },
    "overall_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Overall stay rating (1-5 stars)"
    },
    "room_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Room quality rating (1-5 stars)"
    },
    "dining_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Dining experience rating (1-5 stars)"
    },
    "staff_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Staff service rating (1-5 stars)"
    },
    "cleanliness_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Cleanliness rating (1-5 stars)"
    },
    "amenities_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Hotel amenities rating (1-5 stars)"
    },
    "feedback_text": {
      "type": "string",
      "description": "Written feedback from the guest"
    },
    "would_recommend": {
      "type": "boolean",
      "description": "Would guest recommend hotel to others"
    },
    "sentiment_score": {
      "type": "number",
      "minimum": -1,
      "maximum": 1,
      "description": "AI-calculated sentiment score (-1 to 1)"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "reviewed",
        "responded"
      ],
      "default": "submitted",
      "description": "Feedback status"
    }
  },
  "required": [
    "guest_id",
    "overall_rating"
  ]
}