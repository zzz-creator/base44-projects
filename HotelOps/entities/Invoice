{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "reservation_id": {
      "type": "string",
      "description": "Foreign key to Reservation entity"
    },
    "guest_id": {
      "type": "string",
      "description": "Foreign key to Guest entity"
    },
    "invoice_number": {
      "type": "string",
      "description": "Unique invoice number"
    },
    "invoice_date": {
      "type": "string",
      "format": "date-time",
      "description": "Invoice generation date"
    },
    "room_charges": {
      "type": "number",
      "default": 0,
      "description": "Total room charges"
    },
    "parking_charges": {
      "type": "number",
      "default": 0,
      "description": "Total parking charges"
    },
    "elevator_service_charges": {
      "type": "number",
      "default": 0,
      "description": "Premium elevator service charges"
    },
    "other_charges": {
      "type": "number",
      "default": 0,
      "description": "Miscellaneous charges"
    },
    "tax_amount": {
      "type": "number",
      "default": 0,
      "description": "Tax amount"
    },
    "total_amount": {
      "type": "number",
      "description": "Total invoice amount (sum of all charges + tax)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "draft",
      "description": "Invoice status"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "credit_card",
        "debit_card",
        "bank_transfer",
        "pending"
      ],
      "default": "pending",
      "description": "Payment method used"
    }
  },
  "required": [
    "reservation_id",
    "guest_id",
    "invoice_number"
  ]
}