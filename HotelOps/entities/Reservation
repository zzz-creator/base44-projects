{
  "name": "Reservation",
  "type": "object",
  "properties": {
    "guest_id": {
      "type": "string",
      "description": "Foreign key to Guest entity"
    },
    "room_id": {
      "type": "string",
      "description": "Foreign key to Room entity"
    },
    "check_in_date": {
      "type": "string",
      "format": "date-time",
      "description": "Check-in date and time"
    },
    "check_out_date": {
      "type": "string",
      "format": "date-time",
      "description": "Check-out date and time"
    },
    "actual_check_in": {
      "type": "string",
      "format": "date-time",
      "description": "Actual check-in timestamp"
    },
    "actual_check_out": {
      "type": "string",
      "format": "date-time",
      "description": "Actual check-out timestamp"
    },
    "number_of_guests": {
      "type": "integer",
      "default": 1,
      "description": "Number of guests in reservation"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "checked_in",
        "checked_out",
        "cancelled"
      ],
      "default": "pending",
      "description": "Reservation status"
    },
    "special_requests": {
      "type": "string",
      "description": "Guest special requests or notes"
    },
    "campaign_id": {
      "type": "string",
      "description": "Marketing campaign that led to this booking"
    },
    "offer_id": {
      "type": "string",
      "description": "Offer redeemed for this reservation"
    },
    "source": {
      "type": "string",
      "enum": [
        "direct",
        "campaign",
        "organic",
        "referral"
      ],
      "default": "direct",
      "description": "Booking source"
    }
  },
  "required": [
    "guest_id",
    "room_id",
    "check_in_date",
    "check_out_date"
  ]
}