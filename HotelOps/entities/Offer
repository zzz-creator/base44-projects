{
  "name": "Offer",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Offer title"
    },
    "description": {
      "type": "string",
      "description": "Offer description"
    },
    "offer_type": {
      "type": "string",
      "enum": [
        "discount",
        "upgrade",
        "bonus_points",
        "package",
        "early_bird"
      ],
      "description": "Type of offer"
    },
    "discount_percentage": {
      "type": "number",
      "description": "Discount percentage if applicable"
    },
    "discount_amount": {
      "type": "number",
      "description": "Fixed discount amount if applicable"
    },
    "bonus_points": {
      "type": "integer",
      "description": "Bonus loyalty points if applicable"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "description": "Offer valid from date"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "description": "Offer expiration date"
    },
    "terms_conditions": {
      "type": "string",
      "description": "Offer terms and conditions"
    },
    "min_nights": {
      "type": "integer",
      "description": "Minimum nights required"
    },
    "max_redemptions": {
      "type": "integer",
      "description": "Maximum number of redemptions allowed"
    },
    "current_redemptions": {
      "type": "integer",
      "default": 0,
      "description": "Current number of redemptions"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Offer active status"
    }
  },
  "required": [
    "title",
    "offer_type",
    "valid_from",
    "valid_until"
  ]
}