{
  "name": "Payment",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "student_name": {
      "type": "string",
      "title": "Student Name"
    },
    "amount": {
      "type": "number",
      "title": "Amount"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "title": "Paid Date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "paid",
        "pending",
        "overdue"
      ],
      "default": "pending"
    },
    "plan": {
      "type": "string",
      "title": "Plan",
      "enum": [
        "monthly",
        "quarterly",
        "annual"
      ]
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "student_id",
    "amount",
    "due_date"
  ],
