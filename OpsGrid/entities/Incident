{
  "name": "Incident",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "alert_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "mitigated",
        "resolved"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "assigned_to": {
      "type": "string"
    },
    "root_cause": {
      "type": "string"
    },
    "timeline": {
      "type": "string",
      "description": "JSON array of timeline events"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "status",
    "priority"
  ]
}