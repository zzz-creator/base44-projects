{
  "name": "Alert",
  "type": "object",
  "properties": {
    "type": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "critical"
      ],
      "default": "low"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "acknowledged",
        "resolved"
      ],
      "default": "active"
    },
    "source": {
      "type": "string"
    },
    "acknowledged_by": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "type",
    "severity",
    "message"
  ]
}