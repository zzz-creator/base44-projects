{
  "name": "Staff",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "cashier",
        "supervisor",
        "manager",
        "administrator"
      ],
      "default": "cashier"
    },
    "pin": {
      "type": "string"
    },
    "badge_code": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "last_login": {
      "type": "string"
    }
  },
  "required": [
    "staff_id",
    "name",
    "role",
    "pin"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}